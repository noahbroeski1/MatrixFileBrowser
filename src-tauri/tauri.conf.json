{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MatrixFileBrowser",
  "version": "0.1.0",
  "identifier": "io.github.noahbroeski1.MatrixFileBrowser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Matrix",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$CACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "A richly featured FOSS file browser",
    "longDescription": "MatrixFileBrowser is a file browser with unique ways to view your data: treemaps, photo walls, sunbursts, semantic clusters and more.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
