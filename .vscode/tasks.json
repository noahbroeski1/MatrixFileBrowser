{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build:debug",
      "type": "shell",
      "command": "${env:HOME}/.cargo/bin/cargo",
      "args": [
        "build",
        "--manifest-path",
        "${workspaceFolder}/src-tauri/Cargo.toml",
        "--no-default-features"
      ],
      "problemMatcher": "$rustc",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "build:release",
      "type": "shell",
      "command": "${env:HOME}/.cargo/bin/cargo",
      "args": [
        "build",
        "--release",
        "--manifest-path",
        "${workspaceFolder}/src-tauri/Cargo.toml"
      ],
      "problemMatcher": "$rustc",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "dev:server",
      "type": "shell",
      "isBackground": true,
      "command": "/usr/bin/npm",
      "args": [
        "run",
        "dev"
      ],
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "dev",
      "dependsOn": [
        "build:debug",
        "dev:server"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
