{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Tauri Development Debug",
      "program": "${workspaceFolder}/target/debug/matrix-file-browser",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "dev"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Tauri Production Debug",
      "program": "${workspaceFolder}/target/release/matrix-file-browser",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build:release"
    }
  ]
}
